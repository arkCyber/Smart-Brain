# EditorConfig — 让不同编辑器/IDE 采用一致的缩进与换行风格。
# 见 https://editorconfig.org
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.rs]
# 由 rustfmt 负责 Rust 代码格式（见 rustfmt 默认配置），此处只兜底缩进。
indent_size = 4

[*.{toml,yml,yaml,json}]
indent_size = 2

[*.md]
# Markdown 中行尾双空格是“硬换行”，保留。
trim_trailing_whitespace = false
indent_size = 2

[Makefile]
indent_style = tab
